<IfModule mod_rewrite.c>

RewriteEngine On

RewriteBase /

# 绑定二级域名：m.lol9.cn 到子目录/m

RewriteCond %{HTTP_HOST} ^tg\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/tg/

RewriteRule ^(.*)$ tg/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^bb\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/bb/

RewriteRule ^(.*)$ bb/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^db\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/db/

RewriteRule ^(.*)$ db/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^ff\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/ff/

RewriteRule ^(.*)$ ff/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^dh\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/dh/

RewriteRule ^(.*)$ dh/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^tuchuang\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/tuchuang/

RewriteRule ^(.*)$ tuchuang/$1?Rewrite [L,QSA]


# a.21212121.xyz 现作为全景聚合主站根目录，不再重写重定向至 /a/
# RewriteCond %{HTTP_HOST} ^a\.21212121\.xyz$ [NC]
# RewriteCond %{REQUEST_URI} !^/a/
# RewriteRule ^(.*)$ a/$1?Rewrite [L,QSA]



RewriteCond %{HTTP_HOST} ^sj\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/sj/

RewriteRule ^(.*)$ sj/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^yy\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/yy/

RewriteRule ^(.*)$ yy/$1?Rewrite [L,QSA]


RewriteCond %{HTTP_HOST} ^xb\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/xb/

RewriteRule ^(.*)$ xb/$1?Rewrite [L,QSA]



RewriteCond %{HTTP_HOST} ^l\.21212121\.xyz$ [NC]

RewriteCond %{REQUEST_URI} !^/l/

RewriteRule ^(.*)$ l/$1?Rewrite [L,QSA]


#可以绑定多个 只需重复上三行代码并更改一下域名、目录名 就好了